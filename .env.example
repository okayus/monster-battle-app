# Reference only — not auto-loaded. Export these in your shell (or use Node's
# `--env-file=.env`) before `pnpm dev` if you want to override the defaults
# baked into apps/api/src/index.ts.
#
# DATABASE_URL is resolved relative to the API process's cwd, which for
# `pnpm --filter @mba/api run dev` is apps/api/ — so the default below resolves
# to apps/api/data/app.db, not a repo-root data/ directory.
# docker-compose.yml sets this explicitly to an absolute path instead.
DATABASE_URL=file:./data/app.db
PORT=3000
