    "fmt": "pnpm -r run fmt",
    "fmt:check": "pnpm -r run fmt:check"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "tsx": "4.19.2",
    "typescript": "7.0.2",
    "vite-plus": "^0.2.1",
    "vitest": "4.1.10"
  }
}
